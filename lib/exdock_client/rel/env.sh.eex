# esac

# # Preload release modules so safe runtime-bundle decoding recognizes their atoms.
export RELEASE_MODE=embedded

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
#export RELEASE_NODE=$NODE_NAME

# Set the distribution port range
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min ${DIST_PORT_MIN:-9100} inet_dist_listen_max ${DIST_PORT_MAX:-9150}"

# Set custom EPMD port
export ERL_EPMD_PORT=${EPMD_PORT:-4369}
