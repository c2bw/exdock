# Copy to .env, set fresh secrets, and keep the completed file private.
# Used by compose.quickstart.yml. This file contains placeholders only.

# Browser address for the local quickstart; use localhost as documented.
PHX_HOST=localhost
UI_PORT=4000
UI_EMAIL=admin@example.com
UI_PASSWORD=

# Generate each independently; see README.md for the commands.
SECRET_KEY_BASE=
DB_VAULT_KEY=
AUTH_KEY=

# Unique name for this host's agent.
NODE_NAME=docker-host-1
TZ=Etc/UTC
